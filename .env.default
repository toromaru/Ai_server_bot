# Discord Bot Token (Discord Developer Portal で取得)
TOKEN=Disord bot token ここに貼り付けてください

# Gemini API Key (Google AI Studio で取得)
GEMINI_API_KEY=Gemini api key ここに貼り付けてください

# CLIENT_ID(アプリケーションの Client ID)
CLIENT_ID=You are CLIENT_ID

# 開発用サーバーの Guild ID（テスト時に使用）
GUILD_ID= You are GUILD_ID

# !dejoin（隠しコマンド）で全サーバーから一括退出に使用
DEJOIN_OWNER_ID=You are Discord ID
